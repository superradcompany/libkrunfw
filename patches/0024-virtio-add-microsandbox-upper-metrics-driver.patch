+++ b/drivers/virtio/Kconfig
@@ -31,6 +31,16 @@ menuconfig VIRTIO_MENU
 
 if VIRTIO_MENU
 
+config VIRTIO_MSB_METRICS
+	bool "Microsandbox protected metrics virtio driver"
+	depends on VIRTIO
+	default y
+	help
+	  This driver publishes protected microsandbox guest filesystem metrics
+	  to a private host virtio device. It is intended for bundled
+	  microsandbox kernels; custom kernels may omit it and will simply leave
+	  the corresponding host metrics unavailable.
+
