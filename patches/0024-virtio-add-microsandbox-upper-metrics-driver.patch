diff --git a/drivers/virtio/virtio_msb_metrics.c b/drivers/virtio/virtio_msb_metrics.c
new file mode 100644
index 000000000000..47ed9b8a7ff3
--- /dev/null
+++ b/drivers/virtio/virtio_msb_metrics.c
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Microsandbox protected metrics virtio driver.
+ */
+
+#include <linux/fs.h>
+#include <linux/jiffies.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/namei.h>
+#include <linux/overflow.h>
+#include <linux/path.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/statfs.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/virtio.h>
+#include <linux/virtio_config.h>
+#include <linux/virtio_ids.h>
+
+#define MSB_METRICS_SAMPLE_VERSION 1
+#define MSB_METRICS_SAMPLE_INTERVAL (HZ)
+
+struct msb_metrics_upper_sample {
+	__le32 version;
+	__le32 size;
+	__le64 upper_used_bytes;
+	__le64 upper_free_bytes;
+} __packed;
+
+struct msb_metrics_dev {
+	struct virtio_device *vdev;
+	struct virtqueue *vq;
+	struct mutex path_lock; /* Protects upper_path registration. */
+	spinlock_t vq_lock; /* Protects sample_in_flight and virtqueue updates. */
+	struct delayed_work sample_work;
+	struct path upper_path;
+	bool upper_path_registered;
+	bool sample_in_flight;
+	struct msb_metrics_upper_sample sample;
+};
+
+static struct kobject *msb_metrics_kobj;
+static struct msb_metrics_dev *msb_metrics_device;
+static DEFINE_MUTEX(msb_metrics_device_lock);
+
+static void msb_metrics_drain_vq(struct msb_metrics_dev *mdev)
+{
+	unsigned int len;
+
+	while (virtqueue_get_buf(mdev->vq, &len))
+		mdev->sample_in_flight = false;
+}
+
+static void msb_metrics_publish(struct msb_metrics_dev *mdev, u64 used, u64 free)
+{
+	struct scatterlist sg;
+	unsigned long flags;
+	bool kick = false;
+	int ret;
+
+	spin_lock_irqsave(&mdev->vq_lock, flags);
+
+	msb_metrics_drain_vq(mdev);
+
+	if (mdev->sample_in_flight) {
+		spin_unlock_irqrestore(&mdev->vq_lock, flags);
+		return;
+	}
+
+	mdev->sample.version = cpu_to_le32(MSB_METRICS_SAMPLE_VERSION);
+	mdev->sample.size = cpu_to_le32(sizeof(mdev->sample));
+	mdev->sample.upper_used_bytes = cpu_to_le64(used);
+	mdev->sample.upper_free_bytes = cpu_to_le64(free);
+
+	sg_init_one(&sg, &mdev->sample, sizeof(mdev->sample));
+	ret = virtqueue_add_outbuf(mdev->vq, &sg, 1, mdev, GFP_ATOMIC);
+	if (!ret) {
+		mdev->sample_in_flight = true;
+		kick = true;
+	}
+
+	spin_unlock_irqrestore(&mdev->vq_lock, flags);
+
+	if (kick)
+		virtqueue_kick(mdev->vq);
+}
+
+static void msb_metrics_sample_work(struct work_struct *work)
+{
+	struct msb_metrics_dev *mdev =
+		container_of(to_delayed_work(work), struct msb_metrics_dev, sample_work);
+	struct kstatfs st;
+	struct path upper_path;
+	u64 blocks;
+	u64 used;
+	u64 free;
+	int ret;
+
+	mutex_lock(&mdev->path_lock);
+	if (!mdev->upper_path_registered) {
+		mutex_unlock(&mdev->path_lock);
+		return;
+	}
+	upper_path = mdev->upper_path;
+	path_get(&upper_path);
+	mutex_unlock(&mdev->path_lock);
+
+	ret = vfs_statfs(&upper_path, &st);
+	path_put(&upper_path);
+	if (!ret) {
+		if (st.f_bfree > st.f_blocks)
+			goto reschedule;
+
+		blocks = st.f_blocks - st.f_bfree;
+		if (check_mul_overflow(blocks, st.f_frsize, &used) ||
+		    check_mul_overflow(st.f_bavail, st.f_frsize, &free))
+			goto reschedule;
+
+		msb_metrics_publish(mdev, used, free);
+	}
+
+reschedule:
+	schedule_delayed_work(&mdev->sample_work, MSB_METRICS_SAMPLE_INTERVAL);
+}
+
+static ssize_t upper_path_store(struct kobject *kobj, struct kobj_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct msb_metrics_dev *mdev;
+	struct path resolved;
+	char *path;
+	int ret;
+
+	path = kstrndup(buf, count, GFP_KERNEL);
+	if (!path)
+		return -ENOMEM;
+	strim(path);
+	if (!path[0]) {
+		kfree(path);
+		return -EINVAL;
+	}
+
+	mutex_lock(&msb_metrics_device_lock);
+	mdev = msb_metrics_device;
+	if (!mdev) {
+		mutex_unlock(&msb_metrics_device_lock);
+		kfree(path);
+		return -ENODEV;
+	}
+
+	mutex_lock(&mdev->path_lock);
+	if (mdev->upper_path_registered) {
+		mutex_unlock(&mdev->path_lock);
+		mutex_unlock(&msb_metrics_device_lock);
+		kfree(path);
+		return -EBUSY;
+	}
+	mutex_unlock(&mdev->path_lock);
+
+	ret = kern_path(path, LOOKUP_FOLLOW, &resolved);
+	kfree(path);
+	if (ret) {
+		mutex_unlock(&msb_metrics_device_lock);
+		return ret;
+	}
+
+	mutex_lock(&mdev->path_lock);
+	if (mdev->upper_path_registered) {
+		mutex_unlock(&mdev->path_lock);
+		mutex_unlock(&msb_metrics_device_lock);
+		path_put(&resolved);
+		return -EBUSY;
+	}
+	mdev->upper_path = resolved;
+	mdev->upper_path_registered = true;
+	mutex_unlock(&mdev->path_lock);
+	mutex_unlock(&msb_metrics_device_lock);
+
+	schedule_delayed_work(&mdev->sample_work, 0);
+
+	return count;
+}
+
+static struct kobj_attribute upper_path_attr = __ATTR_WO(upper_path);
+
+static void msb_metrics_vq_done(struct virtqueue *vq)
+{
+	struct msb_metrics_dev *mdev = vq->vdev->priv;
+	unsigned long flags;
+
+	spin_lock_irqsave(&mdev->vq_lock, flags);
+	msb_metrics_drain_vq(mdev);
+	spin_unlock_irqrestore(&mdev->vq_lock, flags);
+}
+
+static int msb_metrics_probe(struct virtio_device *vdev)
+{
+	struct msb_metrics_dev *mdev;
+	struct virtqueue *vq;
+	int ret;
+
+	mdev = kzalloc(sizeof(*mdev), GFP_KERNEL);
+	if (!mdev)
+		return -ENOMEM;
+
+	mutex_init(&mdev->path_lock);
+	spin_lock_init(&mdev->vq_lock);
+	INIT_DELAYED_WORK(&mdev->sample_work, msb_metrics_sample_work);
+	mdev->vdev = vdev;
+	vdev->priv = mdev;
+
+	vq = virtio_find_single_vq(vdev, msb_metrics_vq_done, "upper_metrics");
+	if (IS_ERR(vq)) {
+		ret = PTR_ERR(vq);
+		goto err_free;
+	}
+	mdev->vq = vq;
+
+	mutex_lock(&msb_metrics_device_lock);
+	if (msb_metrics_device) {
+		mutex_unlock(&msb_metrics_device_lock);
+		ret = -EBUSY;
+		goto err_del_vqs;
+	}
+	msb_metrics_device = mdev;
+	mutex_unlock(&msb_metrics_device_lock);
+
+	msb_metrics_kobj = kobject_create_and_add("msb_metrics", kernel_kobj);
+	if (!msb_metrics_kobj) {
+		ret = -ENOMEM;
+		goto err_clear_device;
+	}
+
+	ret = sysfs_create_file(msb_metrics_kobj, &upper_path_attr.attr);
+	if (ret)
+		goto err_put_kobj;
+
+	virtio_device_ready(vdev);
+
+	return 0;
+
+err_put_kobj:
+	kobject_put(msb_metrics_kobj);
+	msb_metrics_kobj = NULL;
+err_clear_device:
+	mutex_lock(&msb_metrics_device_lock);
+	msb_metrics_device = NULL;
+	mutex_unlock(&msb_metrics_device_lock);
+err_del_vqs:
+	vdev->config->del_vqs(vdev);
+err_free:
+	kfree(mdev);
+	return ret;
+}
+
+static void msb_metrics_remove(struct virtio_device *vdev)
+{
+	struct msb_metrics_dev *mdev = vdev->priv;
+
+	cancel_delayed_work_sync(&mdev->sample_work);
+
+	if (msb_metrics_kobj) {
+		sysfs_remove_file(msb_metrics_kobj, &upper_path_attr.attr);
+		kobject_put(msb_metrics_kobj);
+		msb_metrics_kobj = NULL;
+	}
+
+	mutex_lock(&msb_metrics_device_lock);
+	msb_metrics_device = NULL;
+	mutex_unlock(&msb_metrics_device_lock);
+
+	mutex_lock(&mdev->path_lock);
+	if (mdev->upper_path_registered)
+		path_put(&mdev->upper_path);
+	mutex_unlock(&mdev->path_lock);
+
+	vdev->config->reset(vdev);
+	vdev->config->del_vqs(vdev);
+	kfree(mdev);
+}
+
+static const struct virtio_device_id id_table[] = {
+	{ VIRTIO_ID_MSB_METRICS, VIRTIO_DEV_ANY_ID },
+	{ 0 },
+};
+
+static struct virtio_driver virtio_msb_metrics_driver = {
+	.driver.name = KBUILD_MODNAME,
+	.driver.owner = THIS_MODULE,
+	.id_table = id_table,
+	.probe = msb_metrics_probe,
+	.remove = msb_metrics_remove,
+};
+
+module_virtio_driver(virtio_msb_metrics_driver);
+MODULE_DEVICE_TABLE(virtio, id_table);
+MODULE_DESCRIPTION("Microsandbox protected metrics virtio driver");
+MODULE_LICENSE("GPL");
diff --git a/include/uapi/linux/virtio_ids.h b/include/uapi/linux/virtio_ids.h
index 4d2b29958c2a..8d69b4b48df1 100644
--- a/include/uapi/linux/virtio_ids.h
+++ b/include/uapi/linux/virtio_ids.h
@@ -68,6 +68,7 @@
 #define VIRTIO_ID_AUDIO_POLICY		39 /* virtio audio policy */
 #define VIRTIO_ID_BT			40 /* virtio bluetooth */
 #define VIRTIO_ID_GPIO			41 /* virtio gpio */
+#define VIRTIO_ID_MSB_METRICS		0x4d53 /* microsandbox metrics */
 
